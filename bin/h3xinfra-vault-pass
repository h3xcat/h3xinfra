#!/usr/bin/env bash
# Vault password resolver.
#
# Order of precedence:
#   1. $ANSIBLE_VAULT_PASSWORD environment variable (used by CI / runners)
#   2. $H3XINFRA_VAULT_FILE (explicit override path)
#   3. $H3XINFRA_SECRETS_DIR/vault_pass.txt (explicit directory, no fallback)
#   4. /h3xinfra-secrets/vault_pass.txt, if the file exists (a read-only
#      secrets mount that keeps the password off the shared state volume)
#   5. /h3xinfra/state/secrets/vault_pass.txt (legacy location)
#
# This indirection exists because the vault password can be stored on a CIFS
# mount (/h3xinfra/state/secrets/) where mount options force file modes to
# 0777 — Ansible would otherwise treat the password file itself as an
# executable script and try to run it. By printing the file contents from
# this wrapper, the executable bit lives on the wrapper (which is local
# to the repo) instead of on the secret.
set -euo pipefail

if [[ -n "${ANSIBLE_VAULT_PASSWORD:-}" ]]; then
    printf '%s' "$ANSIBLE_VAULT_PASSWORD"
    exit 0
fi

if [[ -n "${H3XINFRA_SECRETS_DIR:-}" ]]; then
    secrets_dir="$H3XINFRA_SECRETS_DIR"
elif [[ -e /h3xinfra-secrets/vault_pass.txt ]]; then
    secrets_dir=/h3xinfra-secrets
else
    secrets_dir=/h3xinfra/state/secrets
fi
vault_file="${H3XINFRA_VAULT_FILE:-$secrets_dir/vault_pass.txt}"

if [[ ! -r "$vault_file" ]]; then
    echo "h3xinfra-vault-pass: cannot read vault password file: $vault_file" >&2
    exit 1
fi

cat "$vault_file"
