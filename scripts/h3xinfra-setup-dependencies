#!/bin/bash
set -euo pipefail
IFS=$'\n\t'

# Install Ansible
sudo apt-get update
sudo apt-get install -y software-properties-common gpg
sudo add-apt-repository --yes --update ppa:ansible/ansible
sudo apt-get install -y ansible

# Install Terraform from HashiCorp's apt repository so apt-get upgrade keeps it current.
if [ ! -f /usr/share/keyrings/hashicorp-archive-keyring.gpg ]; then
    curl -fsSL https://apt.releases.hashicorp.com/gpg \
        | sudo gpg --dearmor -o /usr/share/keyrings/hashicorp-archive-keyring.gpg
fi
if [ ! -f /etc/apt/sources.list.d/hashicorp.list ]; then
    echo "deb [signed-by=/usr/share/keyrings/hashicorp-archive-keyring.gpg] https://apt.releases.hashicorp.com $(lsb_release -cs) main" \
        | sudo tee /etc/apt/sources.list.d/hashicorp.list
    sudo apt-get update
fi
sudo apt-get install -y terraform

sudo apt-get autoremove -y
sudo apt-get clean

# Ansible collections and controller-side python deps are pinned in
# requirements.yml / requirements.txt (Renovate-tracked). Exact pins mean a
# re-run after a Renovate bump installs the new version without --upgrade.
H3XINFRA_ROOT="$(cd "$(dirname "${BASH_SOURCE[0]}")/.." && pwd)"
ansible-galaxy collection install -r "${H3XINFRA_ROOT}/requirements.yml"

# Install python dependencies. Ubuntu 24.04 marks the system Python as
# externally managed (PEP 668). The PPA ansible-core runs on that Python, so its
# controller-side dependencies must be installed there too. --ignore-installed
# puts them under /usr/local next to the apt copies: pip cannot uninstall an apt
# package (for example urllib3), and /usr/local comes first on sys.path.
pip3 install --break-system-packages --ignore-installed -r "${H3XINFRA_ROOT}/requirements.txt"

# Install helm-diff at a pinned release: `helm plugin install` without
# --version fetches whatever tag is newest, so a container rebuild could pick
# up a plugin release that breaks kubernetes.core.helm diffs. Idempotent: a
# matching install is left alone, a different version is replaced.
# renovate: datasource=github-releases depName=databus23/helm-diff
HELM_DIFF_VERSION="v3.15.15"
# helm-diff release signing key. The fingerprint is published in the upstream
# README and in each release note. Helm 4 verifies the signed .prov file of a
# release tarball against this key; a git URL install cannot be verified.
HELM_DIFF_KEY_FINGERPRINT="C5645EF47482257A1F806D2BEA17A2A206AFF8CD"
installed_diff="$(helm plugin list | awk '$1 == "diff" {print $2}')"
if [ -n "${installed_diff}" ] && [ "v${installed_diff}" != "${HELM_DIFF_VERSION}" ]; then
    helm plugin uninstall diff
    installed_diff=""
fi
if [ -z "${installed_diff}" ]; then
    case "$(uname -m)" in
        x86_64) helm_diff_arch=amd64 ;;
        aarch64 | arm64) helm_diff_arch=arm64 ;;
        *) echo "helm-diff: unsupported architecture $(uname -m)" >&2; exit 1 ;;
    esac
    helm_diff_tmp="$(mktemp -d)"
    # gpg can start an agent bound to the temporary homedir: stop it first.
    trap 'gpgconf --homedir "${helm_diff_tmp}" --kill gpg-agent 2>/dev/null || true; rm -rf "${helm_diff_tmp}"' EXIT
    # Import into a throwaway keyring, then export only the pinned key, so a
    # different key served at the URL cannot verify the plugin.
    curl -fsSL https://github.com/databus23.gpg -o "${helm_diff_tmp}/keys.asc"
    gpg --batch --quiet --homedir "${helm_diff_tmp}" --import "${helm_diff_tmp}/keys.asc"
    gpg --batch --homedir "${helm_diff_tmp}" --export "${HELM_DIFF_KEY_FINGERPRINT}" > "${helm_diff_tmp}/helm-diff.gpg"
    if [ ! -s "${helm_diff_tmp}/helm-diff.gpg" ]; then
        echo "helm-diff: signing key ${HELM_DIFF_KEY_FINGERPRINT} not found at https://github.com/databus23.gpg" >&2
        exit 1
    fi
    # The versioned asset name unpacks to plugins/diff, like the old git install.
    helm plugin install \
        "https://github.com/databus23/helm-diff/releases/download/${HELM_DIFF_VERSION}/diff-${HELM_DIFF_VERSION#v}-linux-${helm_diff_arch}.tgz" \
        --keyring "${helm_diff_tmp}/helm-diff.gpg"
fi
