#!/bin/bash
set -euo pipefail
IFS=$'\n\t'

# Install Ansible
sudo apt-get update
sudo apt-get install -y software-properties-common gpg
sudo add-apt-repository --yes --update ppa:ansible/ansible
sudo apt-get install -y ansible

# Install Terraform from HashiCorp's apt repository so apt-get upgrade keeps it current.
if [ ! -f /usr/share/keyrings/hashicorp-archive-keyring.gpg ]; then
    curl -fsSL https://apt.releases.hashicorp.com/gpg \
        | sudo gpg --dearmor -o /usr/share/keyrings/hashicorp-archive-keyring.gpg
fi
if [ ! -f /etc/apt/sources.list.d/hashicorp.list ]; then
    echo "deb [signed-by=/usr/share/keyrings/hashicorp-archive-keyring.gpg] https://apt.releases.hashicorp.com $(lsb_release -cs) main" \
        | sudo tee /etc/apt/sources.list.d/hashicorp.list
    sudo apt-get update
fi
sudo apt-get install -y terraform

sudo apt-get autoremove -y
sudo apt-get clean

# Ansible collections and controller-side python deps are pinned in
# requirements.yml / requirements.txt (Renovate-tracked). Exact pins mean a
# re-run after a Renovate bump installs the new version without --upgrade.
H3XINFRA_ROOT="$(cd "$(dirname "${BASH_SOURCE[0]}")/.." && pwd)"
ansible-galaxy collection install -r "${H3XINFRA_ROOT}/requirements.yml"

# Install python dependencies
pip3 install --upgrade pip
pip3 install -r "${H3XINFRA_ROOT}/requirements.txt"

# Install helm-diff at a pinned release: `helm plugin install` without
# --version fetches whatever tag is newest, so a container rebuild could pick
# up a plugin release that breaks kubernetes.core.helm diffs. Idempotent: a
# matching install is left alone, a different version is replaced.
# renovate: datasource=github-releases depName=databus23/helm-diff
HELM_DIFF_VERSION="v3.15.12"
installed_diff="$(helm plugin list | awk '$1 == "diff" {print $2}')"
if [ -n "${installed_diff}" ] && [ "v${installed_diff}" != "${HELM_DIFF_VERSION}" ]; then
    helm plugin uninstall diff
    installed_diff=""
fi
if [ -z "${installed_diff}" ]; then
    helm plugin install https://github.com/databus23/helm-diff --version "${HELM_DIFF_VERSION}" --verify=false
fi
